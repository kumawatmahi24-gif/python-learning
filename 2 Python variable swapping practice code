CODE 1:-
# Store two values in variables
x = 10
y = 20
# Create a temporary variable
temp = x
# Swap the values
x = y
y = temp
# Display the swapped values
print("X:",x)
print("Y:",y)
Output:- X: 20
         Y:10
CODE 2:-
# Store three values
x = 5
y = 10
z = 15

# Swap the values
x,y = y,z
z,x = x,z
y = x+y
z = y-z
# Display the final values
print("X:",x)
print("Y:",y)
print("Z:",z)
Output:- X:5
         Y:15
         Z:10
